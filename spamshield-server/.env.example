MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spam_shield_db?retryWrites=true&w=majority"
MONGODB_DIRECT_URI="mongodb://<user>:<password>@<shard-00>:27017,<shard-01>:27017,<shard-02>:27017/spam_shield_db?tls=true&replicaSet=<replica-set>&authSource=admin&retryWrites=true&w=majority"
MONGODB_DB_NAME="spam_shield_db"
SERVER_BIND_ADDR="0.0.0.0:8080"
TAILSCALE_IP="100.83.253.15"
# Shared bearer. Leave empty in this example. Set the same value in the Android app settings.
SPAMSHIELD_API_KEY=""
# Optional. When unset, the server serves artifacts/spamshield.apk next to the process.
APK_STORAGE_PATH=""
APK_METADATA_PATH=""
RUST_LOG="info,spamshield_server=debug"
